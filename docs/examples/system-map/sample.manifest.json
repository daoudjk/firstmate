{
  "schema": "fm-system-map.manifest.v1",
  "project": "example",
  "title": "Example platform",
  "description": "A generic job platform: an operator submits work, a service wakes, one isolated worker runs it, results are stored, and compute returns to zero.",
  "revision": 1,
  "modes": ["idle", "active"],
  "expected_mode": "idle",
  "groups": [
    {"id": "operator", "title": "Operator"},
    {"id": "control", "title": "Control plane"},
    {"id": "workers", "title": "Worker range"},
    {"id": "firstmate", "title": "Firstmate ownership"}
  ],
  "components": [
    {"id": "console", "title": "Operator console", "kind": "ui", "group": "operator", "x": 0, "y": 0,
     "description": "Submits a job from idle.",
     "implementation": {"state": "built", "note": "Declared by the owner; replace with a completion record once a bound task lands."}},
    {"id": "api", "title": "API service", "kind": "service", "group": "control", "x": 1, "y": 0,
     "description": "Accepts jobs and wakes the worker.",
     "owners": [{"role": "owner", "task": "example-owner"}],
     "intended": {"idle": "zero", "active": "running"},
     "observe": [{"id": "api-ecs", "adapter": "aws.ecs_service", "binding": "api_service"}],
     "version_from": "api-ecs"},
    {"id": "queue", "title": "Job queue", "kind": "queue", "group": "control", "x": 1, "y": 1,
     "intended": {"idle": "empty", "active": "holding"},
     "observe": [{"id": "queue-sqs", "adapter": "aws.sqs_queue", "binding": "job_queue"}]},
    {"id": "control-switch", "title": "Kill switch", "kind": "control", "group": "control", "x": 1, "y": 2,
     "intended": {"idle": "halted", "active": "open"},
     "observe": [{"id": "control-item", "adapter": "aws.dynamodb_item", "binding": "control_item"}]},
    {"id": "results", "title": "Results table", "kind": "table", "group": "control", "x": 2, "y": 2,
     "intended": {"idle": "present", "active": "present"},
     "observe": [{"id": "results-ddb", "adapter": "aws.dynamodb_table", "binding": "results_table"}]},
    {"id": "worker-host", "title": "Worker host", "kind": "compute", "group": "workers", "x": 3, "y": 0,
     "description": "One isolated worker per job; stopped when idle.",
     "intended": {"idle": "stopped", "active": "running"},
     "observe": [{"id": "worker-ec2", "adapter": "aws.ec2_instance", "binding": "worker_host"}],
     "version_from": "worker-ec2", "pin": {"binding": "worker_host", "field": "pin"}},
    {"id": "source", "title": "Platform source", "kind": "repository", "group": "control", "x": 2, "y": 0,
     "observe": [{"id": "source-git", "adapter": "git.revision", "binding": "platform_source", "role": "version"}],
     "version_from": "source-git"},
    {"id": "owner", "title": "Platform owner", "kind": "owner", "group": "firstmate", "x": 0, "y": 2,
     "observe": [{"id": "owner-task", "adapter": "firstmate.task", "binding": "owner_task", "role": "info"}]}
  ],
  "connections": [
    {"id": "console-submits", "title": "Console submits job", "from": "console", "to": "api"},
    {"id": "api-enqueues", "title": "API enqueues job", "from": "api", "to": "queue"},
    {"id": "queue-wakes-worker", "title": "Queued job wakes worker", "from": "queue", "to": "worker-host",
     "implementation": {"state": "not-started", "note": "Example of a declared gap."}},
    {"id": "control-gates-worker", "title": "Kill switch gates worker", "from": "control-switch", "to": "worker-host"},
    {"id": "worker-writes-results", "title": "Worker writes results", "from": "worker-host", "to": "results"}
  ],
  "lifecycle": {
    "title": "Job lifecycle",
    "phases": [
      {"id": "submit", "title": "Submit from idle", "subjects": ["console", "api"], "criterion": "mvp-submit"},
      {"id": "run", "title": "Run isolated job", "subjects": ["worker-host"], "criterion": "mvp-run"},
      {"id": "zero", "title": "Return to zero", "subjects": ["api", "worker-host"], "criterion": "mvp-zero"}
    ]
  },
  "acceptance": [
    {"id": "mvp-submit", "title": "Console submits from idle", "phase": "submit", "subjects": ["console", "api"]},
    {"id": "mvp-run", "title": "Isolated job runs on the pinned image", "phase": "run", "subjects": ["worker-host"]},
    {"id": "mvp-zero", "title": "Compute returns to zero", "phase": "zero", "subjects": ["api", "worker-host"]}
  ],
  "prerequisites": [
    {
      "id": "submission-api",
      "title": "Submission API",
      "producer": "api",
      "resource": "Named API service",
      "phases": [
        "submit"
      ],
      "baseline": "both",
      "observation": "api-ecs",
      "expected_state": "zero",
      "authorization": "awaiting-authorization",
      "next_check": "Obtain current configuration and console submission proof from the owner."
    },
    {
      "id": "console-config",
      "title": "Console configuration",
      "producer": "console",
      "resource": "Installed console configuration",
      "phases": [
        "submit"
      ],
      "baseline": "both",
      "authorization": "unknown",
      "next_check": "Import an owner receipt for the installed configuration; source alone does not establish installation."
    }
  ],
  "known_gaps": [
    {"id": "wake-gap", "title": "A queued job does not wake the worker yet", "severity": "high",
     "detail": "Example of an explicit intended-versus-built gap.", "subjects": ["queue-wakes-worker"],
     "owners": [{"role": "owner", "task": "example-owner"}]}
  ],
  "credentials": [
    {"id": "api-cert", "title": "API certificate", "kind": "tls-leaf", "purpose": "Service identity for the API.",
     "owner": "Platform owner", "expires": "2099-01-01T00:00:00Z", "rotation": "Reissue from the platform CA",
     "subjects": ["api"]}
  ]
}
